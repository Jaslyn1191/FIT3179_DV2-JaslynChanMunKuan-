{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": 500,
    "height": 300,
    "title": "Change in Public Transport Use by State/Territory, 2016–2021",
    "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/main/data/2016_2021_travel_to_work.json"
    },
    "mark": {
        "type": "line",
        "point": true,
        "tooltip": true
    },
    "encoding": {
        "x": {
            "field": "year",
            "type": "ordinal",
            "scale": {"padding": 0.5},
            "title": "Year",
            "axis": {
                "labelAngle": 0
            }
        }, 
        "y": {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage of Employed Persons"
        },
        "color": {
            "field": "state",
            "type": "nominal",
            "title": "State/Territory",
            "scale": {
                "range": [
                "#0072B2", 
                "#E69F00", 
                "#56B4E9", 
                "#F0E442",
                "#CC79A7", 
                "#000000", 
                "#332288", 
                "#882255"  
                ]
            }
        }
    }
}
