{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height": 300,
  "width": 500,
  "title": "Journey to Work Mode Comparison (2016 vs 2021)",
  "data": {
    "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/main/data/2016_2021_transport_mode.json"
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": { 
      "field": "transport",
      "type": "nominal",
      "title": "Mode of Transport",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": { 
      "field": "count",
      "type": "quantitative", 
      "title": "Number of Commuters"
    },
    "xOffset": {
      "field": "year",
      "type": "nominal"
    },
    "color": { 
      "field": "year",
      "type": "nominal",
      "title": "Year",
      "scale": {
        "domain": [2016, 2021],
        "range": ["#3b82f6", "#0d9488"]
      }
    },
    "tooltip": [
      {
        "field": "transport",
        "type": "nominal",
        "title": "Mode of Transport"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Number of Commuters"
      }
    ]
  }
}