{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Employed Persons Travelling to Work by Public Transport, by State",
  "width": 500,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
    "format": {"type": "topojson", "feature": "STE_2016_AUST"}
  },
  "transform": [
    {
        "lookup": "properties.STE_NAME16",
        "from": {
            "data": {
                "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/data/travel_to_work.csv"
            },
            "key": "State/Territory",
            "fields": ["Number of employed persons"]
        }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#757575",
    "strokeWidth": 0.5
},
  "encoding": {
    "color": {
        "field": "Number of employed persons",
        "type": "quantitative",
        "scale": {"type": "log"}
    },
    "tooltip": [
        {
            "field": "properties.STE_NAME16", 
            "type": "nominal", 
            "title": "State/Territory"
        },
        {
            "field": "Number of employed persons",
            "type": "quantitative",
            "title": "Employed persons"
        }
    ]
    }
}