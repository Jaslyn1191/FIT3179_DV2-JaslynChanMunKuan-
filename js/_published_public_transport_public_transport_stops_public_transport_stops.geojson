{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Public Transport Stops in Victoria",
  "width": 500,
  "height": 300,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
        "format": {"type": "topojson", "feature": "STE_2016_AUST"}
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME16 === 'Victoria'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/dot_map/transportation_station_vic/js/_published_public_transport_public_transport_stops_public_transport_stops.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.geometry.coordinates[0] >= 140.96 && datum.geometry.coordinates[0] <= 149.97 && datum.geometry.coordinates[1] >= -39.15 && datum.geometry.coordinates[1] <= -35.8"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 20
      },
      "encoding": {
        "longitude": {
          "field": "geometry.coordinates[0]",
          "type": "quantitative"
        },
        "latitude": {
          "field": "geometry.coordinates[1]",
          "type": "quantitative"
        },
        "color": {
          "field": "properties.MODE",
          "title": "Types of transportation",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "properties.STOP_NAME",
            "title": "Stop"
          },
          {
            "field": "properties.MODE",
            "title": "Types of transportation"
          }
        ]
      }
    }
  ]
}