{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Public Transport Mode Share by State (2001-2021)",
  "width": 500,
  "height": 300,
  "params": [
    {
      "name": "Year_selection",
      "value": 2016,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2021,
        "step": 5,
        "name": "Year: "
      }
    },
    {
      "name": "zoom_level",
      "value": 800,
      "bind": {
        "input": "range",
        "min": 400,
        "max": 5000,
        "step": 100,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [134, -27],
      "bind": {
        "input": "select",
        "options": [
          [134, -27],
          [147, -32],
          [145, -36.5],
          [144, -23],
          [135, -30],
          [120, -25],
          [146.5, -42],
          [133, -20],
          [149.1, -35.3]
        ],
        "labels": [
          "Australia Wide",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "Map Centre: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/main/data/travel_to_work.csv"
  },
  "transform": [
    {"filter": "datum.year == Year_selection"},
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/main/js/STE_2016_AUST.json",
          "format": {"type": "topojson", "feature": "STE_2016_AUST"}
        },
        "key": "properties.STE_NAME16"
      },
      "as": "geo"
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.8},
  "encoding": {
    "shape": {"field": "geo", "type": "geojson"},
    "color": {
      "field": "public transport mode share",
      "type": "quantitative",
      "title": "Mode Share (%)",
      "scale": {
        "type": "threshold",
        "domain": [3.5, 6.5, 9.5],
        "range": ["#fee5d9", "#fcae91", "#fb6a4a", "#cb181d"]
      },
      "legend": {
        "type": "symbol",
        "symbolType": "square",
        "symbolSize": 200,
        "values": [1, 4, 7, 10],
        "labelExpr": "datum.value == 1 ? '1 - 3' : datum.value == 4 ? '4 - 6' : datum.value == 7 ? '7 - 9' : '10 - 12'"
      }
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {
        "field": "public transport mode share",
        "type": "quantitative",
        "title": "Public Transport Share (%)"
      },
      {
        "field": "number of employed persons",
        "type": "quantitative",
        "title": "Public Transport Commuters",
        "format": ","
      },
      {
        "field": "total employed persons",
        "type": "quantitative",
        "title": "Total Employed",
        "format": ","
      },
      {"field": "year", "type": "quantitative", "title": "Year"}
    ]
  },
  "config": {}
}