{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height": 300,
  "width": 500,
  "title": "Public Transport Commuters by State (2001–2021)",
  "data": {
    "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/main/data/travel_to_work.csv"
},
  "mark": {
    "type": "line",
    "point": true,
    "tooltip": true
  },
  "encoding": {
    "x": {
        "field": "year",
        "type": "ordinal",
        "title": "Year",
        "axis": {
            "labelAngle": 0
        }
    },
    "y": {
        "field": "number of employed persons", 
        "type": "quantitative",
        "title": "Number of Employed Persons"
    },
    "color": {
        "field": "state", 
        "type": "nominal",
        "title": "State/Territory"
    }
  }
}
