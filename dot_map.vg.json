
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Public Transport Stops in Victoria",
    "subtitle": "Distribution of stops by transport mode"
  },
  "width": 800,
  "height": 500,
  "params": [
    {
      "name": "zoom_level",
      "value": 4500,
      "bind": {
        "input": "range",
        "min": 1000,
        "max": 10000,
        "step": 250,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [144.5, -36.8],
      "bind": {
        "input": "select",
        "options": [
          [144.5, -36.8],
          [145, -37.8],
          [143.5, -36.5],
          [146.5, -37],
          [142, -36.5],
          [144, -38.5]
        ],
        "labels": [
          "Victoria Wide",
          "Melbourne",
          "Western Victoria",
          "Eastern Victoria",
          "North-West Victoria",
          "South-West Victoria"
        ],
        "name": "Map Centre: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.7
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME16",
            "type": "nominal",
            "title": "State"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME16 === 'Victoria'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#dbeafe",
        "stroke": "#475569",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/dot_map/transportation_station_vic/js/_published_public_transport_public_transport_stops_public_transport_stops.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.geometry.type === 'Point'"
        },
        {
          "filter": "datum.geometry.coordinates[0] >= 140.9 && datum.geometry.coordinates[0] <= 149.0 && datum.geometry.coordinates[1] >= -39.2 && datum.geometry.coordinates[1] <= -34.0"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 8,
        "opacity": 0.65,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "geometry.coordinates[0]",
          "type": "quantitative"
        },
        "latitude": {
          "field": "geometry.coordinates[1]",
          "type": "quantitative"
        },
        "color": {
          "field": "properties.MODE",
          "type": "nominal",
          "title": "Transport mode",
          "scale": {
            "scheme": "tableau10"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "properties.STOP_NAME",
            "type": "nominal",
            "title": "Stop name"
          },
          {
            "field": "properties.MODE",
            "type": "nominal",
            "title": "Transport mode"
          },
          {
            "field": "geometry.coordinates[1]",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".4f"
          },
          {
            "field": "geometry.coordinates[0]",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".4f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}