{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Public Transport Stops in Victoria",
    "subtitle": "Distribution of stops by transport mode"
  },
  "width": 800,
  "height": 500,
  "params": [
    {
      "name": "zoom_level",
      "value": 4500,
      "bind": {
        "input": "range",
        "min": 1000,
        "max": 10000,
        "step": 250,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [144.5, -36.8],
      "bind": {
        "input": "select",
        "options": [
          [144.5, -36.8],
          [145, -37.81],
          [143.5, -36.5],
          [146.5, -37],
          [142, -36.5],
          [144, -38.5]
        ],
        "labels": [
          "Victoria Wide",
          "Melbourne Metropolitan",
          "Western Victoria",
          "Eastern Victoria",
          "North-West Victoria",
          "South-West Victoria"
        ],
        "name": "Map Centre: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.7
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME16",
            "type": "nominal",
            "title": "State"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/map/transport_method/js/STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME16 === 'Victoria'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e0f2fe",
        "stroke": "#0284c7",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Jaslyn1191/FIT3179_DV2-JaslynChanMunKuan-/refs/heads/dot_map/transportation_station_vic/js/_published_public_transport_public_transport_stops_public_transport_stops.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.geometry.type === 'Point'"
        },
        {
          "filter": "datum.geometry.coordinates[0] >= 140.9 && datum.geometry.coordinates[0] <= 149.0 && datum.geometry.coordinates[1] >= -39.2 && datum.geometry.coordinates[1] <= -34.0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "stroke": "#ffffff",
        "strokeWidth": 0.2
      },
      "encoding": {
        "longitude": {
          "field": "geometry.coordinates[0]",
          "type": "quantitative"
        },
        "latitude": {
          "field": "geometry.coordinates[1]",
          "type": "quantitative"
        },
        "size": {
          "expr": "clamp(zoom_level / 300, 14, 70)"
        },
        "color": {
          "field": "properties.MODE",
          "type": "nominal",
          "title": "Transport Mode",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "tooltip": [
          {
            "field": "properties.STOP_NAME",
            "type": "nominal",
            "title": "Stop Name"
          },
          {
            "field": "properties.MODE",
            "type": "nominal",
            "title": "Transport Mode"
          },
          {
            "field": "geometry.coordinates[1]",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".4f"
          },
          {
            "field": "geometry.coordinates[0]",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".4f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}